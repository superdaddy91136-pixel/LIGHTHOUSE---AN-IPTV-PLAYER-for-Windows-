{
  "productName": "Lighthouse",
  "version": "1.9.1",
  "identifier": "dev.fredol.open-tv",
  "build": {
    "frontendDist": "../dist/open-tv/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "ng build --configuration=production"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lighthouse",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "visible": false,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "transparent": true
      },
      {
        "label": "player-overlay",
        "title": "",
        "url": "assets/overlay.html",
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/Lighthouse-taskbar-clean.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis/hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "./windows/fragments/deps.wxs"
        ],
        "componentGroupRefs": [
          "DependencyComponents"
        ],
        "componentRefs": [
          "MpvComponent",
          "FfmpegComponent",
          "YtDlpComponent"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      },
      "rpm": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      }
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/schema.json"
}
